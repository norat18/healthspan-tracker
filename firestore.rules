rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can read and write only their own document. Nothing else is accessible.
    // Only end-to-end encrypted data can be saved (schema 2: AES-GCM ciphertext + 12-byte IV, made on the device).
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'iv', 'savedAtMs', 'updatedAt', 'schema'])
        && request.resource.data.schema == 2
        && request.resource.data.iv is string && request.resource.data.iv.size() == 16
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
    // Daily copies for "Restore an earlier version": owner can read, add a day's copy once, and delete old ones.
    match /users/{uid}/history/{day} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['data', 'iv', 'savedAtMs', 'schema'])
        && request.resource.data.schema == 2
        && request.resource.data.iv is string && request.resource.data.iv.size() == 16
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
